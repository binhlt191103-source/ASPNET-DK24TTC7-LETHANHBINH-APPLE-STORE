@model IEnumerable<ProTechTiveGear.Models.Blog>
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}
<div class="card shadow mb-4">
    <div class="card-header py-3">
        <h2 class="text-center" style="color:#008b8b;">Tin Tức Apple</h2>
        <p>
            <a href="@Url.Action("Create")" class="btn btn-success" style="border-radius:20px;"><i class="fa fa-plus"></i> Thêm mới</a>
        </p>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-bordered" id="dataTable" width="100%" cellspacing="0">
                <thead>
                    <tr>
                        <th>Ảnh</th>
                        <th>Tiêu Đề</th>
                        <th>Ngày Đăng</th>
                        <th>Mô Tả Ngắn</th>
                        <th>Chi Tiết</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <img width="100" height="100" style="object-fit:cover; border-radius:8px;" src="~/img/Blog/@item.Picture" />
                            </td>
                            <td><b>@item.Title</b></td>
                            <td>@String.Format("{0:dd/MM/yyyy}", item.DateImport)</td>
                            <td>@item.ShortTitle</td>
                            <td><div style="max-width:200px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">@item.Describe</div></td>
                            <td>
                                <a href="@Url.Action("Edit", new {id=item.ID})" class="btn btn-sm btn-warning">Cập Nhập</a>
                                <a href="@Url.Action("Delete", new {id=item.ID})" class="btn btn-sm btn-danger" onclick="return confirm('Xóa bài [@item.Title]?')">Xóa</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
@model ProTechTiveGear.Models.Blog
@{
    ViewBag.Title = "Thêm mới";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}
<h2>Thêm mới Tin Tức</h2>
@using (Html.BeginForm("Create", "Blogs", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()
    <div class="form-horizontal">
        <h4>Tin Tức Apple</h4>
        <hr />
        <div class="form-group">
            <h5 class="control-label col-md-2">Ảnh</h5>
            <div class="col-md-10">
                <input type="file" name="PictureUpload" class="form-control" required />
            </div>
        </div>
        <div class="form-group">
            <h5 class="control-label col-md-2">Tiêu Đề</h5>
            <div class="col-md-10">
                @Html.EditorFor(model => model.Title, new { htmlAttributes = new { @class = "form-control", required = "required" } })
            </div>
        </div>
        <div class="form-group">
            <h5 class="control-label col-md-2">Mô Tả Ngắn</h5>
            <div class="col-md-10">
                @Html.EditorFor(model => model.ShortTitle, new { htmlAttributes = new { @class = "form-control", required = "required" } })
            </div>
        </div>
        <div class="form-group">
            <h5 class="control-label col-md-2">Chi Tiết</h5>
            <div class="col-md-10">
                @Html.TextAreaFor(model => model.Describe, new { @class = "form-control", rows = "10" })
            </div>
        </div>
        <div class="form-group">
            <div class="col-md-offset-2 col-md-10">
                <input type="submit" value="Thêm" class="btn btn-success" style="border-radius:20px;" />
            </div>
        </div>
    </div>
}
<div>@Html.ActionLink("Quay lại", "Index")</div>
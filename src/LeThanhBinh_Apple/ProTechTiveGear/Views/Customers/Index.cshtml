@model IEnumerable<ProTechTiveGear.Models.Customer>
@{
    ViewBag.Title = "Khách Hàng";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}
<div class="card shadow mb-4">
    <div class="card-header py-3">
        <h2 class="text-center" style="color:#1cc88a;">Danh sách khách hàng</h2>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-bordered" id="dataTable" width="100%" cellspacing="0">
                <thead>
                    <tr>
                        <th>Tài Khoản</th>
                        <th>Họ Tên</th>
                        <th>Email</th>
                        <th>SĐT</th>
                        <th>Địa Chỉ</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td><b>@item.Username</b></td>
                            <td>@item.Name</td>
                            <td>@item.EmailAddress</td>
                            <td>@item.Phone</td>
                            <td><div style="max-width:150px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">@item.Address</div></td>
                            <td>
                                <a href="@Url.Action("Edit", new { id = item.ID })" class="btn btn-sm btn-warning" style="border-radius:15px;">Sửa</a>
                                <a href="@Url.Action("Delete", new { id = item.ID })" class="btn btn-sm btn-danger" style="border-radius:15px;" onclick="return confirm('Xóa khách hàng [@item.Username]?')">Xóa</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
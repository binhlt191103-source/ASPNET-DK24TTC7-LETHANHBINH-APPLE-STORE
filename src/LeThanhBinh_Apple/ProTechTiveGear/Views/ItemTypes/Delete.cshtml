@model ProTechTiveGear.Models.ItemType

@{
    ViewBag.Title = "Delete";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<h2>Xóa</h2>

<h3>Bạn chắc chắn muốn xóa?</h3>
<div>
    <h4>Loại Sản Phẩm</h4>
    <hr />

    @* DÒNG NÀY QUAN TRỌNG - ĐỂ HIỆN LỖI "KHÔNG THỂ XÓA..." *@
    @Html.ValidationSummary(true, "", new { @class = "text-danger", @style = "font-weight:bold; font-size:16px;" })

    <dl class="dl-horizontal">
        <dt>Tên</dt>
        <dd>@Html.DisplayFor(model => model.TypeName)</dd>

        <dt>Loại</dt>
        <dd>@Html.DisplayFor(model => model.Menu.Name)</dd>
    </dl>

    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()

        <div class="form-actions no-color">
            <input type="submit" value="Xóa" class="btn btn-danger" /> |
            @Html.ActionLink("Quay lại", "Index")
        </div>
    }
</div>
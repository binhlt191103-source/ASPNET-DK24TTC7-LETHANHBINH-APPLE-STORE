@model IEnumerable<ProTechTiveGear.Models.Blog>
@foreach (var item in Model)
{
    <div class="col-lg-3 col-md-6 col-12">
        <div class="product-card">
            <a href="@Url.Action("BlogDetail","AuraStore", new { id=item.ID })" class="product-img-box">
                <img src="~/img/Blog/@item.Picture" alt="@item.Title">
            </a>
            <div class="product-info">
                <a href="@Url.Action("BlogDetail","AuraStore", new { id=item.ID })" class="product-title">@item.Title</a>
                <div style="font-size:13px; color:#888;">@String.Format("{0:dd/MM/yyyy}", item.DateImport)</div>
            </div>
            <a href="@Url.Action("BlogDetail","AuraStore", new { id=item.ID })" class="btn-add-cart">Xem chi tiết</a>
        </div>
    </div>
}
